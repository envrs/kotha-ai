{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Index",
  "description": "Symbol and chunk index for a project, built from LSP and file scans and used for search and context assembly.",
  "type": "object",
  "definitions": {
    "entry": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "description": "File the entry belongs to." },
        "name": { "type": "string", "description": "Symbol or chunk name." },
        "kind": {
          "type": "string",
          "enum": ["package", "module", "function", "method", "type", "field", "variable", "file", "chunk"],
          "description": "Entry classification."
        },
        "language": { "type": "string", "description": "Language id, e.g. go, python." },
        "location": { "$ref": "location.json", "description": "Span of the entry in its file." },
        "signature": { "type": "string", "description": "Declaration signature for symbols." },
        "score": { "type": "number", "description": "Relevance score for ranked retrieval." }
      },
      "required": ["path", "name", "kind"]
    }
  },
  "properties": {
    "project_id": { "$ref": "project-id.json" },
    "kind": {
      "type": "string",
      "enum": ["symbol", "file", "chunk"],
      "description": "Granularity of the index."
    },
    "version": { "type": "integer", "minimum": 1, "description": "Index format version." },
    "stats": {
      "type": "object",
      "properties": {
        "files": { "type": "integer", "minimum": 0 },
        "entries": { "type": "integer", "minimum": 0 },
        "duration_ms": { "type": "integer", "minimum": 0 }
      },
      "description": "Build statistics."
    },
    "generated_at": { "type": "integer", "format": "int64", "description": "Unix timestamp in milliseconds." },
    "entries": { "type": "array", "items": { "$ref": "#/definitions/entry" }, "description": "Indexed entries." }
  },
  "required": ["project_id", "kind"]
}
