{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProjectDirectories",
  "description": "Directory inventory for a project: which folders were scanned, how they were classified and which were excluded.",
  "type": "object",
  "properties": {
    "project_id": { "$ref": "project-id.json" },
    "generated_at": { "type": "integer", "format": "int64", "description": "Unix timestamp in milliseconds." },
    "include": { "type": "array", "items": { "type": "string" }, "description": "Glob patterns that force inclusion." },
    "exclude": { "type": "array", "items": { "type": "string" }, "description": "Glob patterns excluded from the scan." },
    "directories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "description": "Directory path relative to the project root." },
          "kind": {
            "type": "string",
            "enum": ["source", "test", "config", "docs", "build", "vendor", "other"],
            "description": "Classification of the directory."
          },
          "included": { "type": "boolean", "default": true, "description": "False when the directory was excluded by ignore rules." },
          "file_count": { "type": "integer", "minimum": 0, "description": "Files found in the directory." }
        },
        "required": ["path", "kind"]
      },
      "description": "Scanned directories."
    }
  },
  "required": ["project_id", "directories"]
}
