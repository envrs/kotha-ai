{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MCPEvent",
  "description": "Events from Model Context Protocol servers: connection state changes and tool inventory updates.",
  "type": "object",
  "allOf": [{ "$ref": "event.json" }],
  "properties": {
    "source": { "const": "mcp" },
    "type": { "pattern": "^mcp\\.[a-z0-9_.]+$", "description": "MCP event type, e.g. mcp.connected." },
    "payload": {
      "type": "object",
      "properties": {
        "server": { "type": "string", "description": "Configured MCP server name." },
        "transport": { "type": "string", "enum": ["stdio", "sse", "http"], "description": "Transport in use." },
        "state": {
          "type": "string",
          "enum": ["connecting", "connected", "disconnected", "error"],
          "description": "Server connection state."
        },
        "tools": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tool names currently advertised by the server."
        },
        "error": { "type": "string", "description": "Failure reason when state is error." }
      },
      "required": ["server", "state"]
    }
  }
}
