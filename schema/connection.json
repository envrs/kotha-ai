{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Connection",
  "description": "Transport settings and runtime state for an external process or endpoint such as an MCP server or LSP.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "format": "uuid", "description": "Connection id." },
    "kind": {
      "type": "string",
      "enum": ["stdio", "sse", "http", "websocket", "ssh", "pty"],
      "description": "Transport used by the connection."
    },
    "name": { "type": "string", "description": "Display name, e.g. the MCP server name." },
    "url": { "type": "string", "format": "uri", "description": "Endpoint for sse, http and websocket transports." },
    "command": { "type": "string", "description": "Executable launched for stdio transports." },
    "args": { "type": "array", "items": { "type": "string" }, "description": "Command line arguments." },
    "env": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Extra environment variables." },
    "headers": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Extra request headers." },
    "status": {
      "type": "string",
      "enum": ["disconnected", "connecting", "connected", "error"],
      "default": "disconnected",
      "description": "Current connection state."
    },
    "last_error": { "type": "string", "description": "Most recent connection error." },
    "reconnect": {
      "type": "object",
      "properties": {
        "attempts": { "type": "integer", "minimum": 0, "description": "Consecutive failed attempts." },
        "max_attempts": { "type": "integer", "minimum": 1, "default": 5 },
        "backoff_ms": { "type": "integer", "minimum": 1, "default": 1000, "description": "Base backoff between attempts." }
      },
      "description": "Reconnect policy."
    },
    "created_at": { "type": "integer", "format": "int64", "description": "Unix timestamp in milliseconds." },
    "last_connected_at": { "type": "integer", "format": "int64", "description": "Unix timestamp in milliseconds." }
  },
  "required": ["id", "kind"]
}
