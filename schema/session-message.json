{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionMessage",
  "description": "A persisted chat message inside a session, stored as an ordered list of typed content blocks.",
  "type": "object",
  "definitions": {
    "content_block": {
      "type": "object",
      "description": "Single typed unit of message content.",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["text", "reasoning", "image_url", "tool_call", "tool_result"]
        },
        "text": { "type": "string", "description": "Text or reasoning content." },
        "image_url": { "type": "string", "description": "Attached image URL." },
        "id": { "type": "string", "description": "Tool call id." },
        "name": { "type": "string", "description": "Tool name." },
        "input": { "type": "string", "description": "JSON encoded tool arguments." },
        "tool_call_id": { "type": "string", "description": "Tool call this result answers." },
        "content": { "type": "string", "description": "Tool result payload." },
        "is_error": { "type": "boolean", "default": false, "description": "True when the tool result is an error." }
      },
      "required": ["type"],
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "tool_result" } } },
          "then": { "required": ["tool_call_id"] }
        }
      ]
    }
  },
  "properties": {
    "id": { "type": "string", "description": "Message id (see identifier.json)." },
    "session_id": { "$ref": "session-id.json" },
    "role": { "type": "string", "enum": ["system", "user", "assistant", "tool"] },
    "blocks": {
      "type": "array",
      "items": { "$ref": "#/definitions/content_block" },
      "description": "Ordered content blocks that make up the message."
    },
    "model": { "type": "string", "description": "Model that produced an assistant message." },
    "tokens": { "type": "integer", "minimum": 0, "description": "Tokens attributed to this message." },
    "cost": { "type": "number", "minimum": 0, "description": "Cost in USD attributed to this message." },
    "created_at": { "type": "integer", "format": "int64", "description": "Unix timestamp in milliseconds." }
  },
  "required": ["id", "session_id", "role", "blocks"]
}
