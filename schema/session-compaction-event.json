{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionCompactionEvent",
  "description": "Event emitted while a session transcript is compacted into a summary. Shares the session envelope without inheriting the lifecycle action of session-event.json.",
  "type": "object",
  "allOf": [{ "$ref": "event.json" }, { "$ref": "session-event.json#/definitions/envelope" }],
  "properties": {
    "type": { "pattern": "^session\\.compaction\\.[a-z0-9_]+$", "description": "Compaction event type, e.g. session.compaction.completed." },
    "payload": {
      "type": "object",
      "properties": {
        "phase": {
          "type": "string",
          "enum": ["started", "completed", "failed"],
          "description": "Compaction phase."
        },
        "messages_compacted": { "type": "integer", "minimum": 0, "description": "Messages folded into the summary." },
        "tokens_before": { "type": "integer", "minimum": 0, "description": "Transcript tokens before compaction." },
        "tokens_after": { "type": "integer", "minimum": 0, "description": "Transcript tokens after compaction." },
        "summary_message_id": { "type": "string", "description": "Message id of the generated summary." },
        "error": { "type": "string", "description": "Failure reason when phase is failed." }
      },
      "required": ["phase"]
    }
  }
}
