{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkspaceEvent",
  "description": "Events for workspace lifecycle: creation, settings changes and shutdown.",
  "type": "object",
  "allOf": [{ "$ref": "event.json" }],
  "properties": {
    "source": { "const": "workspace" },
    "type": { "pattern": "^workspace\\.[a-z0-9_.]+$", "description": "Workspace event type, e.g. workspace.created." },
    "payload": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": ["created", "updated", "closed"],
          "description": "Workspace lifecycle action."
        },
        "root": { "type": "string", "description": "Workspace root path." },
        "name": { "type": "string", "description": "Workspace display name." }
      },
      "required": ["action"]
    }
  },
  "required": ["workspace_id"]
}
