{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Model",
  "description": "A single model offered by a provider, including context limits, pricing and capabilities.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 1, "description": "Globally unique model id, provider.model (e.g. anthropic.claude-sonnet-4)." },
    "name": { "type": "string", "description": "Human readable model name." },
    "provider": { "type": "string", "description": "Provider id (see provider.json)." },
    "context_window": { "type": "integer", "minimum": 1, "description": "Maximum context tokens." },
    "max_output_tokens": { "type": "integer", "minimum": 1, "description": "Maximum completion tokens." },
    "cost": {
      "type": "object",
      "description": "USD price per million tokens.",
      "properties": {
        "input": { "type": "number", "minimum": 0 },
        "output": { "type": "number", "minimum": 0 },
        "cache_read": { "type": "number", "minimum": 0 },
        "cache_write": { "type": "number", "minimum": 0 }
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "reasoning": { "type": "boolean", "description": "Supports reasoning/thinking output." },
        "tools": { "type": "boolean", "description": "Supports tool calling." },
        "vision": { "type": "boolean", "description": "Accepts image inputs." },
        "attachment": { "type": "boolean", "description": "Accepts file attachments." },
        "temperature": { "type": "boolean", "description": "Honours the temperature setting." },
        "reasoning_effort": { "type": "boolean", "description": "Honours the reasoning effort setting." }
      }
    },
    "modalities": {
      "type": "array",
      "items": { "type": "string", "enum": ["text", "image", "audio"] },
      "description": "Supported input/output modalities."
    },
    "release_date": { "type": "string", "format": "date", "description": "Model release date (YYYY-MM-DD)." },
    "engine": { "type": "string", "description": "Engine family used for token estimation." }
  },
  "required": ["id", "name", "provider"]
}
