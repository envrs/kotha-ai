{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PTY",
  "description": "A pseudo-terminal session spawned by the bash tool, addressed by a short-lived ticket rather than a process id.",
  "type": "object",
  "properties": {
    "ticket": { "$ref": "pty-ticket.json" },
    "session_id": { "$ref": "session-id.json" },
    "title": { "type": "string", "description": "Label shown in terminal lists." },
    "shell": { "type": "string", "default": "/bin/sh", "description": "Shell executable." },
    "cwd": { "type": "string", "description": "Working directory of the process." },
    "cols": { "type": "integer", "minimum": 1, "default": 80, "description": "Terminal width in columns." },
    "rows": { "type": "integer", "minimum": 1, "default": 24, "description": "Terminal height in rows." },
    "status": {
      "type": "string",
      "enum": ["running", "exited", "error"],
      "description": "Process state."
    },
    "exit_code": { "type": "integer", "description": "Process exit code, present once exited." },
    "created_at": { "type": "integer", "format": "int64", "description": "Unix timestamp in milliseconds." },
    "exited_at": { "type": "integer", "format": "int64", "description": "Unix timestamp in milliseconds." }
  },
  "required": ["ticket", "session_id", "status"]
}
