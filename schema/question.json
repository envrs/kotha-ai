{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Question",
  "description": "A question the agent asks the user, with selectable options. Clients render it and reply with an answer.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "description": "Question id (see identifier.json)." },
    "session_id": { "$ref": "session-id.json" },
    "header": { "type": "string", "description": "Short heading shown above the question." },
    "prompt": { "type": "string", "minLength": 1, "description": "The question text." },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string", "minLength": 1, "description": "Display label." },
          "description": { "type": "string", "description": "Secondary explanation." },
          "value": { "type": "string", "description": "Value returned with the answer; defaults to label." },
          "selected": { "type": "boolean", "default": false, "description": "Pre-selected option." }
        },
        "required": ["label"]
      },
      "description": "Choices offered to the user."
    },
    "multiple": { "type": "boolean", "default": false, "description": "Allow selecting more than one option." },
    "allow_other": { "type": "boolean", "default": false, "description": "Allow a free-form answer." },
    "status": {
      "type": "string",
      "enum": ["pending", "answered", "cancelled"],
      "default": "pending",
      "description": "Question state."
    },
    "answer": {
      "type": "object",
      "properties": {
        "selected": { "type": "array", "items": { "type": "string" }, "description": "Chosen option values." },
        "text": { "type": "string", "description": "Free-form answer when allow_other is set." }
      },
      "description": "User reply, present once status is answered."
    },
    "created_at": { "type": "integer", "format": "int64", "description": "Unix timestamp in milliseconds." },
    "answered_at": { "type": "integer", "format": "int64", "description": "Unix timestamp in milliseconds." }
  },
  "required": ["id", "prompt", "options", "status"]
}
