{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IDEEvent",
  "description": "Events exchanged with IDE extensions: editor actions, selections and apply-diff requests.",
  "type": "object",
  "allOf": [{ "$ref": "event.json" }],
  "properties": {
    "source": { "const": "ide" },
    "type": { "pattern": "^ide\\.[a-z0-9_.]+$", "description": "IDE event type, e.g. ide.ask." },
    "payload": {
      "type": "object",
      "properties": {
        "editor": {
          "type": "string",
          "enum": ["vscode", "jetbrains", "zed", "other"],
          "description": "Editor that produced the event."
        },
        "action": {
          "type": "string",
          "enum": ["ask", "open_file", "apply_diff", "selection"],
          "description": "Requested editor action."
        },
        "uri": { "type": "string", "description": "Editor document URI." },
        "selection": { "$ref": "location.json" }
      },
      "required": ["action"]
    }
  }
}
