{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Catalog",
  "description": "Index of installable units discovered from builtin, user, project and registry sources. Powers discovery UIs and completion.",
  "type": "object",
  "definitions": {
    "entry": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["command", "skill", "plugin", "agent", "model", "provider"],
          "description": "What is being catalogued."
        },
        "name": { "type": "string", "description": "Entry name, unique per kind." },
        "version": { "type": "string", "description": "Entry version when the source carries one." },
        "description": { "type": "string" },
        "source": { "type": "string", "enum": ["builtin", "user", "project", "registry"], "description": "Origin of the entry." },
        "origin": { "type": "string", "description": "File, package or URL the entry was loaded from." },
        "schema": { "type": "string", "description": "Schema file that validates the entry, e.g. command.json." },
        "enabled": { "type": "boolean", "default": true }
      },
      "required": ["kind", "name", "source"]
    }
  },
  "properties": {
    "version": { "type": "integer", "minimum": 1, "description": "Catalog format version." },
    "generated_at": { "type": "integer", "format": "int64", "description": "Unix timestamp in milliseconds." },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/definitions/entry" },
      "description": "All catalogued items."
    }
  },
  "required": ["version", "entries"]
}
