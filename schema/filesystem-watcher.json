{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FilesystemWatcher",
  "description": "Configuration and runtime status of a recursive directory watcher, plus the shape of the change events it emits.",
  "type": "object",
  "definitions": {
    "change": {
      "type": "object",
      "description": "A single filesystem change reported by the watcher.",
      "properties": {
        "path": { "type": "string", "description": "Path that changed." },
        "kind": { "type": "string", "enum": ["create", "change", "delete", "rename"] },
        "previous_path": { "type": "string", "description": "Source path for rename events." },
        "ts": { "type": "integer", "format": "int64", "description": "Unix timestamp in milliseconds." }
      },
      "required": ["path", "kind"]
    }
  },
  "properties": {
    "id": { "type": "string", "format": "uuid", "description": "Watcher id." },
    "roots": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "Directories to watch." },
    "include": { "type": "array", "items": { "type": "string" }, "description": "Glob patterns to include." },
    "exclude": { "type": "array", "items": { "type": "string" }, "description": "Glob patterns to ignore." },
    "events": {
      "type": "array",
      "items": { "type": "string", "enum": ["create", "change", "delete", "rename"] },
      "description": "Change kinds that are reported; empty means all."
    },
    "recursive": { "type": "boolean", "default": true, "description": "Watch subdirectories." },
    "debounce_ms": { "type": "integer", "minimum": 0, "default": 100, "description": "Coalesce window for rapid changes." },
    "status": { "type": "string", "enum": ["idle", "watching", "error"], "default": "idle", "description": "Watcher state." },
    "last_error": { "type": "string", "description": "Most recent watcher error." },
    "last_event_at": { "type": "integer", "format": "int64", "description": "Unix timestamp in milliseconds." },
    "changes": { "type": "array", "items": { "$ref": "#/definitions/change" }, "description": "Recent buffered changes." }
  },
  "required": ["id", "roots"]
}
