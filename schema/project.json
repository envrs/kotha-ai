{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project",
  "description": "A project: a version controlled root directory that owns sessions, workspaces and configuration.",
  "type": "object",
  "properties": {
    "id": { "$ref": "project-id.json" },
    "name": { "type": "string", "minLength": 1, "description": "Display name, usually the directory name." },
    "root": { "type": "string", "minLength": 1, "description": "Absolute path to the project root." },
    "vcs": {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "enum": ["git", "none"], "default": "none", "description": "Version control system in use." },
        "remote": { "type": "string", "description": "Origin remote URL." },
        "branch": { "type": "string", "description": "Currently checked out branch." }
      },
      "description": "Version control metadata."
    },
    "tags": { "type": "array", "items": { "type": "string" }, "description": "User labels for grouping projects." },
    "last_session_id": { "$ref": "session-id.json" },
    "created_at": { "type": "integer", "format": "int64", "description": "Unix timestamp in milliseconds." },
    "updated_at": { "type": "integer", "format": "int64", "description": "Unix timestamp in milliseconds." }
  },
  "required": ["id", "name", "root"]
}
