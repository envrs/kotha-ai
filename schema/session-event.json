{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionEvent",
  "description": "Event family for session lifecycle changes. The shared session envelope lives in definitions.envelope so sibling session.* families can reuse it without inheriting the lifecycle action requirement.",
  "type": "object",
  "definitions": {
    "envelope": {
      "type": "object",
      "properties": {
        "source": { "const": "session" },
        "type": { "pattern": "^session\\.[a-z0-9_.]+$", "description": "Session event type, e.g. session.updated." },
        "session_id": { "$ref": "session-id.json" }
      },
      "required": ["session_id"]
    }
  },
  "allOf": [{ "$ref": "event.json" }, { "$ref": "#/definitions/envelope" }],
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": ["created", "updated", "renamed", "archived", "deleted"],
          "description": "Session lifecycle action."
        },
        "title": { "type": "string", "description": "Title after the action." }
      },
      "required": ["action"]
    }
  }
}
