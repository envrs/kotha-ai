{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionDelivery",
  "description": "Delivery record for a session message streamed to a client. Tracks ordering and acknowledgement per channel.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "format": "uuid", "description": "Delivery id." },
    "session_id": { "$ref": "session-id.json" },
    "message_id": { "type": "string", "description": "Message being delivered (see session-message.json)." },
    "channel": {
      "type": "string",
      "enum": ["sse", "websocket", "stream", "poll"],
      "description": "Transport the delivery was handed to."
    },
    "seq": { "type": "integer", "minimum": 0, "description": "Monotonic sequence number per channel." },
    "status": {
      "type": "string",
      "enum": ["pending", "delivered", "acknowledged", "failed"],
      "default": "pending",
      "description": "Delivery state."
    },
    "attempts": { "type": "integer", "minimum": 0, "description": "Send attempts so far." },
    "last_error": { "type": "string", "description": "Most recent delivery error." },
    "created_at": { "type": "integer", "format": "int64", "description": "Unix timestamp in milliseconds." },
    "delivered_at": { "type": "integer", "format": "int64", "description": "Unix timestamp in milliseconds." },
    "acknowledged_at": { "type": "integer", "format": "int64", "description": "Unix timestamp in milliseconds." }
  },
  "required": ["session_id", "message_id", "channel", "seq", "status"]
}
