{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LLM",
  "description": "Provider-neutral completion request parameters and the usage envelope returned with a completion.",
  "type": "object",
  "definitions": {
    "message": {
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["system", "user", "assistant", "tool"] },
        "content": { "type": "string", "description": "Message text." },
        "name": { "type": "string", "description": "Optional sender name." }
      },
      "required": ["role", "content"]
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "parameters": { "type": "object", "description": "JSON Schema for the tool arguments." }
      },
      "required": ["name"]
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cache_read_tokens": { "type": "integer", "minimum": 0 },
        "cache_creation_tokens": { "type": "integer", "minimum": 0 },
        "cost": { "type": "number", "minimum": 0, "description": "Cost in USD." }
      }
    }
  },
  "properties": {
    "provider": { "type": "string", "description": "Provider id (see provider.json)." },
    "model": { "type": "string", "description": "Model id (see model.json)." },
    "messages": {
      "type": "array",
      "items": { "$ref": "#/definitions/message" },
      "description": "Conversation turns in chronological order."
    },
    "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
    "top_p": { "type": "number", "minimum": 0, "maximum": 1 },
    "max_tokens": { "type": "integer", "minimum": 1, "description": "Completion token budget." },
    "stop": { "type": "array", "items": { "type": "string" }, "description": "Stop sequences." },
    "stream": { "type": "boolean", "default": false, "description": "Request a streaming response." },
    "tool_choice": { "type": "string", "description": "Forced tool selection, e.g. auto, none or a tool name." },
    "tools": { "type": "array", "items": { "$ref": "#/definitions/tool" }, "description": "Tools offered to the model." },
    "usage": { "$ref": "#/definitions/usage" },
    "finish_reason": {
      "type": "string",
      "enum": ["end_turn", "max_tokens", "tool_use", "canceled", "error", "permission_denied", "unknown"],
      "description": "Why the completion stopped."
    }
  },
  "required": ["model", "messages"]
}
