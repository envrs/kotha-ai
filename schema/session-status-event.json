{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionStatusEvent",
  "description": "Event carrying the running status and token counters of a session. Shares the session envelope without inheriting the lifecycle action of session-event.json.",
  "type": "object",
  "allOf": [{ "$ref": "event.json" }, { "$ref": "session-event.json#/definitions/envelope" }],
  "properties": {
    "type": { "pattern": "^session\\.status\\.[a-z0-9_]+$", "description": "Status event type, e.g. session.status.changed." },
    "payload": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["idle", "running", "waiting_input", "compacting", "error"],
          "description": "Session status after the change."
        },
        "message_count": { "type": "integer", "minimum": 0, "description": "Persisted message count." },
        "prompt_tokens": { "type": "integer", "minimum": 0, "description": "Accumulated input tokens." },
        "completion_tokens": { "type": "integer", "minimum": 0, "description": "Accumulated output tokens." },
        "error": { "type": "string", "description": "Failure reason when status is error." }
      },
      "required": ["status"]
    }
  }
}
