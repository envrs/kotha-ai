{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Command",
  "description": "A slash command: a named prompt template with arguments, optionally pinned to a model or agent.",
  "type": "object",
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "description": "Command name without the leading slash." },
    "aliases": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Alternative names for the command."
    },
    "description": { "type": "string", "description": "Shown in the command palette." },
    "template": { "type": "string", "description": "Prompt template with {{argument}} placeholders." },
    "arguments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "required": { "type": "boolean", "default": false },
          "default": { "type": "string" }
        },
        "required": ["name"]
      },
      "description": "Arguments accepted by the template."
    },
    "model": { "type": "string", "description": "Model override for this command." },
    "agent": { "type": "string", "description": "Agent override for this command." },
    "source": { "type": "string", "enum": ["builtin", "user", "project"], "description": "Where the command was defined." },
    "hidden": { "type": "boolean", "default": false, "description": "Hidden commands are invocable but not listed." }
  },
  "required": ["name", "description", "template"]
}
