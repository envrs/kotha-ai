{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Location",
  "description": "A position or span inside a file. Line and column are zero-based to match the Language Server Protocol.",
  "type": "object",
  "properties": {
    "path": { "type": "string", "minLength": 1, "description": "Absolute path or workspace-relative path." },
    "line": { "type": "integer", "minimum": 0, "description": "Zero-based start line." },
    "column": { "type": "integer", "minimum": 0, "description": "Zero-based start column." },
    "end_line": { "type": "integer", "minimum": 0, "description": "Zero-based end line; defaults to line for a single position." },
    "end_column": { "type": "integer", "minimum": 0, "description": "Zero-based end column." }
  },
  "required": ["path", "line"]
}
