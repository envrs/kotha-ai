{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Revert",
  "description": "A revert operation that restores files, a turn or a whole session to an earlier state.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "format": "uuid", "description": "Revert id." },
    "session_id": { "$ref": "session-id.json" },
    "project_id": { "$ref": "project-id.json" },
    "target": {
      "type": "string",
      "enum": ["file", "turn", "session"],
      "description": "Granularity being reverted."
    },
    "paths": { "type": "array", "items": { "type": "string" }, "description": "Files restored by the revert." },
    "diff": { "$ref": "file-diff.json", "description": "Diff that was rolled back." },
    "status": {
      "type": "string",
      "enum": ["pending", "applied", "failed"],
      "default": "pending",
      "description": "Revert state."
    },
    "message": { "type": "string", "description": "User or agent supplied reason for the revert." },
    "error": { "type": "string", "description": "Failure reason when status is failed." },
    "created_at": { "type": "integer", "format": "int64", "description": "Unix timestamp in milliseconds." },
    "applied_at": { "type": "integer", "format": "int64", "description": "Unix timestamp in milliseconds." }
  },
  "required": ["id", "target", "status"]
}
